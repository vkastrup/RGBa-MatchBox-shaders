<ShaderNodePreset
   SupportsAdaptiveDegradation="False" SupportsAction="False"
   SupportsTransition="False" SupportsTimeline="False"
   TimelineUseBack="False" MatteProvider="False" ShaderType="Matchbox"
   SoftwareVersion="2025.0.0" LimitInputsToTexture="True"
   Version="1" Description="Film halation — red/orange halo scatter from bright areas, physically based on film emulsion layer re-exposure." Name="Halation">

   <Shader OutputBitDepth="Output" Index="1">

      <Uniform Index="0" NoInput="Error"
               Tooltip="" DisplayName="Source"
               InputColor="67, 77, 83" Mipmaps="False"
               GL_TEXTURE_WRAP_T="GL_CLAMP_TO_EDGE"
               GL_TEXTURE_WRAP_S="GL_CLAMP_TO_EDGE"
               GL_TEXTURE_MAG_FILTER="GL_LINEAR"
               GL_TEXTURE_MIN_FILTER="GL_LINEAR"
               Type="sampler2D" Name="input1">
      </Uniform>

      <Uniform ResDependent="None"
               Max="1.0" Min="0.0" Default="0.5" Inc="0.01"
               Tooltip="Minimum luminance to trigger halation. Raise to restrict the effect to only the brightest highlights."
               Row="0" Col="0" Page="0"
               Type="float" DisplayName="Threshold" Name="threshold">
      </Uniform>

      <Uniform ResDependent="None"
               Max="150.0" Min="1.0" Default="30.0" Inc="1.0"
               Tooltip="Scatter radius in pixels. Controls how far the halo extends from the bright source."
               Row="1" Col="0" Page="0"
               Type="float" DisplayName="Radius" Name="radius">
      </Uniform>

      <Uniform ResDependent="None"
               Max="8.0" Min="0.5" Default="2.0" Inc="0.1"
               Tooltip="Falloff rate. Higher values produce a softer, more diffuse halo; lower values produce a sharper, denser edge."
               Row="2" Col="0" Page="0"
               Type="float" DisplayName="Softness" Name="softness">
      </Uniform>

      <Uniform ResDependent="None"
               Max="1.0" Min="0.0" Default="0.35" Inc="0.01"
               Tooltip="Halo colour. 0 = pure red (red layer only). 1 = orange (red + green layers, simulating higher intensity re-exposure)."
               Row="3" Col="0" Page="0"
               Type="float" DisplayName="Hue" Name="hue">
      </Uniform>

      <Uniform ResDependent="None"
               Max="5.0" Min="0.0" Default="1.0" Inc="0.05"
               Tooltip="Halation intensity."
               Row="0" Col="1" Page="0"
               Type="float" DisplayName="Amount" Name="amount">
      </Uniform>

      <Uniform ResDependent="None"
               Max="5.0" Min="0.0" Default="0.0" Inc="0.05"
               Tooltip="Bloom intensity. Adds a neutral luminance glow on top of halation. Set to 0 to disable."
               Row="1" Col="1" Page="0"
               Type="float" DisplayName="Bloom" Name="bloom_amount">
      </Uniform>

      <Uniform ResDependent="None"
               Max="64" Min="8" Default="32" Inc="1"
               Tooltip="Sample count. Higher = smoother result, lower = visible grain. 32 is a good balance."
               Row="2" Col="1" Page="0"
               Type="int" DisplayName="Samples" Name="samples">
      </Uniform>

   </Shader>

   <Page Name="Controls" Page="0">
      <Col Name="Halation" Col="0" Page="0">
      </Col>
      <Col Name="Amount" Col="1" Page="0">
      </Col>
   </Page>

</ShaderNodePreset>
